# Copy to backend/.env for local backend development. Never commit .env.
FACEIT_API_KEY=
FACEIT_CLIENT_ID=
FACEIT_CLIENT_SECRET=
FACEIT_REDIRECT_URI=
STEAM_API_KEY=
FACEIT_WEBHOOK_SECRET=
DATABASE_URL=sqlite:///./companion.db
APP_BASE_URL=http://localhost:8000
MOBILE_URL=http://localhost:3000
MOBILE_DEEP_LINK_SCHEME=cs2companion
SECURE_COOKIES=false
DEMO_MODE=true
# Frontend variables: copy to apps/mobile/.env and apps/website/.env as needed.
# localhost works only when the browser and API run on the same computer.
# For a phone on Wi-Fi, replace localhost with the computer's LAN IP in both
# NUXT_PUBLIC_API_BASE and backend MOBILE_URL / APP_BASE_URL.
NUXT_PUBLIC_API_BASE=http://localhost:8000
NUXT_PUBLIC_MOBILE_URL=http://localhost:3000
